-- 
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local localPlayer = Players.LocalPlayer

-- Configuration
local isSilentAimEnabled = false
local TOGGLE_KEY = Enum.KeyCode.E -- Press E to toggle
local FOV_RADIUS = 200 
local DEEP_BLUE = Color3.fromRGB(10, 80, 220) -- Deep blue color

-- Environment & Safeguards
local env = (getgenv and getgenv()) or _G or {}
local safeHookMeta = env.hookmetamethod or hookmetamethod
local safeGetNamecall = env.getnamecallmethod or getnamecallmethod
local safeCheckCaller = env.checkcaller or checkcaller or function() return false end

-- GUI Setup (Protected UI parent)
local success, uiParent = pcall(function()
    if typeof(gethui) == "function" then return gethui() end
    return localPlayer:WaitForChild("PlayerGui")
end)
if not success or not uiParent then uiParent = localPlayer:WaitForChild("PlayerGui") end

if uiParent:FindFirstChild("ARCS_GlowingFOV") then
    uiParent:FindFirstChild("ARCS_GlowingFOV"):Destroy()
end

local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ARCS_GlowingFOV"
screenGui.ResetOnSpawn = false
screenGui.IgnoreGuiInset = true
screenGui.DisplayOrder = 99999
screenGui.Parent = uiParent

-- FOV Master Frame
local fovMaster = Instance.new("Frame")
fovMaster.Size = UDim2.new(0, FOV_RADIUS * 2, 0, FOV_RADIUS * 2)
fovMaster.AnchorPoint = Vector2.new(0.5, 0.5)
fovMaster.BackgroundTransparency = 1
fovMaster.Visible = false
fovMaster.Parent = screenGui

local coreRing = Instance.new("Frame")
coreRing.Size = UDim2.new(1, 0, 1, 0)
coreRing.BackgroundTransparency = 1
coreRing.Parent = fovMaster

local coreCorner = Instance.new("UICorner")
coreCorner.CornerRadius = UDim.new(1, 0)
coreCorner.Parent = coreRing

-- Layered UIStrokes for a smooth outer glow effect
local outerGlow = Instance.new("UIStroke")
outerGlow.Color = DEEP_BLUE
outerGlow.Thickness = 6
outerGlow.Transparency = 0.75
outerGlow.Parent = coreRing

local midGlow = Instance.new("UIStroke")
midGlow.Color = DEEP_BLUE
midGlow.Thickness = 3.5
midGlow.Transparency = 0.4
midGlow.Parent = coreRing

local coreStroke = Instance.new("UIStroke")
coreStroke.Color = DEEP_BLUE
coreStroke.Thickness = 1.5
coreStroke.Transparency = 0
coreStroke.Parent = coreRing

-- Keybind Listener
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == TOGGLE_KEY then
        isSilentAimEnabled = not isSilentAimEnabled
        fovMaster.Visible = isSilentAimEnabled
        print("[ARCS] Silent Aim:", isSilentAimEnabled and "ACTIVE" or "DISABLED")
    end
end)

-- RenderStepped to center FOV on screen
RunService.RenderStepped:Connect(function()
    local curCam = Workspace.CurrentCamera
    if curCam then
        local center = Vector2.new(curCam.ViewportSize.X / 2, curCam.ViewportSize.Y / 2)
        fovMaster.Position = UDim2.new(0, center.X, 0, center.Y)
    end
end)

-- Closest Target Finder
local function getClosestTargetPosition()
    local curCam = Workspace.CurrentCamera
    if not curCam then return nil end
    
    local closestPart = nil
    local shortestDist = FOV_RADIUS
    local screenCenter = Vector2.new(curCam.ViewportSize.X / 2, curCam.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local char = player.Character
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            local targetPart = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
            
            if humanoid and humanoid.Health > 0 and targetPart then
                local screenPos, onScreen = curCam:WorldToViewportPoint(targetPart.Position)
                if onScreen then
                    local screenVector = Vector2.new(screenPos.X, screenPos.Y)
                    local distToCenter = (screenVector - screenCenter).Magnitude
                    
                    if distToCenter < shortestDist then
                        shortestDist = distToCenter
                        closestPart = targetPart
                    end
                end
            end
        end
    end
    
    return closestPart and closestPart.Position or nil
end

-- Secure Metamethod Hook
if safeHookMeta and safeGetNamecall then
    pcall(function()
        local oldNamecall
        oldNamecall = safeHookMeta(game, "__namecall", function(self, ...)
            local method = safeGetNamecall()
            local args = {...}

            if not safeCheckCaller() and isSilentAimEnabled then
                local targetPos = getClosestTargetPosition()
                
                if targetPos then
                    if method == "Raycast" and self == Workspace then
                        local origin = args[1]
                        local direction = args[2]
                        if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                            args[2] = (targetPos - origin).Unit * direction.Magnitude
                            return oldNamecall(self, unpack(args))
                        end
                    elseif (method == "ScreenPointToRay" or method == "ViewportPointToRay") and (self == Workspace.CurrentCamera or (typeof(self) == "Instance" and self:IsA("Camera"))) then
                        local camera = Workspace.CurrentCamera
                        local origin = camera and camera.CFrame.Position or Vector3.zero
                        local dir = (targetPos - origin).Unit * 1000
                        return Ray.new(origin, dir)
                    end
                end
            end

            return oldNamecall(self, ...)
        end)
    end)
end

print("[ARCS] Glowing Deep Blue FOV & Silent Aim loaded. Press [E] to toggle.")
