local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 40
local enabled = false
local lockedTarget = nil

-- Compensate for Roblox's TopBar GUI Inset (36px) to fix vertical tracking drift
local guiInset = GuiService:GetGuiInset()

-- Create an intense, heavy gradient glow effect using 12 layered circles
local glowRings = {}
local layerCount = 12
for i = 1, layerCount do
    local ring = Drawing.new("Circle")
    ring.Visible = false
    ring.Radius = FOV_RADIUS + (i * 1.5)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.55 - (i * 0.04), 0.03, 0.55)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

-- Main FOV Circle
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = false
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function updateVisibility(isVisible)
    FOV_Circle.Visible = isVisible
    for _, ring in ipairs(glowRings) do
        ring.Visible = isVisible
    end
end

-- Toggle tracking and FOV visibility using 'E'
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        updateVisibility(enabled)
        if not enabled then
            lockedTarget = nil
        end
    end
end)

local function getTarget()
    local mousePos = UserInputService:GetMouseLocation()
    
    -- Sticky Lock: Retain lock on target as long as they are alive and on-screen
    if lockedTarget and lockedTarget.Parent and lockedTarget.Parent:FindFirstChild("Humanoid") then
        local humanoid = lockedTarget.Parent.Humanoid
        if humanoid.Health > 0 then
            local _, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen then
                return lockedTarget
            end
        end
    end
    
    -- If no target is locked, scan for the closest target within FOV_RADIUS
    lockedTarget = nil
    local closest, minD = nil, FOV_RADIUS
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local humanoid = p.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    -- Account for topbar offset when comparing against mouse location
                    local targetScreenPos = Vector2.new(pos.X, pos.Y)
                    local dist = (targetScreenPos - mousePos).Magnitude
                    if dist < minD then
                        minD = dist
                        closest = head
                    end
                end
            end
        end
    end
    
    lockedTarget = closest
    return lockedTarget
end

-- Bind directly to RenderPriority.Last to run AFTER camera physics updates (eliminates jump stutter)
RunService:BindToRenderStep("MouseLockPipeline", Enum.RenderPriority.Last.Value, function()
    local mousePos = UserInputService:GetMouseLocation()
    
    -- Update visual FOV circle and glow ring positions
    FOV_Circle.Position = mousePos
    for _, ring in ipairs(glowRings) do
        ring.Position = mousePos
    end
    
    if not enabled then return end
    
    local target = getTarget()
    if target then
        local targetScreenPos, onScreen = Camera:WorldToViewportPoint(target.Position)
        if onScreen then
            -- Calculate absolute pixel delta between target and cursor position
            local deltaX = targetScreenPos.X - mousePos.X
            local deltaY = (targetScreenPos.Y - guiInset.Y) - (mousePos.Y - guiInset.Y)
            
            -- Apply direct physical relative mouse displacement
            if mousemoverel then
                mousemoverel(deltaX, deltaY)
            end
        end
    end
end)
