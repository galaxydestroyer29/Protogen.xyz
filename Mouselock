local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 55

-- Center of the viewport screen for stable camera locking
local function getScreenCenter()
    return Camera.ViewportSize / 2
end

local glowRings = {}
for i = 1, 8 do
    local ring = Drawing.new("Circle")
    ring.Visible = true
    ring.Radius = FOV_RADIUS + (i * 2)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.6 - (i * 0.06), 0.05, 0.6)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = true
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function getTarget()
    local closest, minD = nil, FOV_RADIUS
    local screenCenter = getScreenCenter()
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local humanoid = p.Character:FindFirstChild("Humanoid")
            if head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local screenPos = Vector2.new(pos.X, pos.Y)
                    local dist = (screenPos - screenCenter).Magnitude
                    if dist < minD then
                        minD = dist
                        closest = head
                    end
                end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    local screenCenter = getScreenCenter()
    
    -- Keep FOV circle and gradient glow centered on screen
    FOV_Circle.Position = screenCenter
    for _, ring in ipairs(glowRings) do
        ring.Position = screenCenter
    end
    
    local target = getTarget()
    if target then
        -- Locks camera instantly and maintains lock through jumps and movement
        Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, target.Position)
    end
end)
