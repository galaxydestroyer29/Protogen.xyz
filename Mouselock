local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 40
-- TWEAK THIS: If the cursor sits too high at long distances, increase this number (e.g., 10, 25, 36)
-- If it sits too low, make it negative (e.g., -10)
local Y_OFFSET = 15 

local enabled = false
local lockedTarget = nil

-- Intense gradient glow setup
local glowRings = {}
local layerCount = 12
for i = 1, layerCount do
    local ring = Drawing.new("Circle")
    ring.Visible = false
    ring.Radius = FOV_RADIUS + (i * 1.5)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.55 - (i * 0.04), 0.03, 0.55)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

-- Main FOV Circle
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = false
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function updateVisibility(isVisible)
    FOV_Circle.Visible = isVisible
    for _, ring in ipairs(glowRings) do
        ring.Visible = isVisible
    end
end

-- Toggle with 'E'
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        updateVisibility(enabled)
        if not enabled then
            lockedTarget = nil
        end
    end
end)

local function getTarget()
    local mouse = UserInputService:GetMouseLocation()
    
    -- 100% Hard-Lock logic
    if lockedTarget and lockedTarget.Parent and lockedTarget.Parent:FindFirstChild("Humanoid") then
        local humanoid = lockedTarget.Parent.Humanoid
        if humanoid.Health > 0 then
            local _, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen then
                return lockedTarget
            end
        end
    end
    
    lockedTarget = nil
    local closest, minD = nil, FOV_RADIUS
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local humanoid = p.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                -- Strictly use ViewportPoint to match hardware mouse behavior 1:1
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if dist <= minD then
                        minD = dist
                        closest = head
                    end
                end
            end
        end
    end
    
    lockedTarget = closest
    return lockedTarget
end

RunService.RenderStepped:Connect(function()
    local mouse = UserInputService:GetMouseLocation()
    
    FOV_Circle.Position = mouse
    for _, ring in ipairs(glowRings) do
        ring.Position = mouse
    end
    
    if not enabled then return end
    
    local target = getTarget()
    if target then
        -- Retrieve pure Viewport coordinates
        local pos, onScreen = Camera:WorldToViewportPoint(target.Position)
        
        if onScreen then
            -- Apply our manual vertical compensator to fix the distance drop-off
            local targetX = pos.X
            local targetY = pos.Y + Y_OFFSET
            
            -- Calculate precise distance from hardware mouse to target pixel
            local deltaX = targetX - mouse.X
            local deltaY = targetY - mouse.Y
            
            -- Instantly step the cursor directly to the target
            mousemoverel(deltaX, deltaY)
        end
    end
end)
