local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 40

-- === SENSITIVITY TUNING ===
-- Adjust this if the mouse moves too fast or too slow.
-- Because this uses smooth 3D angles, it will not break when you move, jump, or change distance.
local MOUSE_SENSITIVITY = 1.0 
-- ==========================

local enabled = false
local lockedTarget = nil

-- Intense gradient glow setup (12 layered rings)
local glowRings = {}
local layerCount = 12
for i = 1, layerCount do
    local ring = Drawing.new("Circle")
    ring.Visible = false
    ring.Radius = FOV_RADIUS + (i * 1.5)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.55 - (i * 0.04), 0.03, 0.55)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

-- Main FOV Circle
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = false
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function updateVisibility(isVisible)
    FOV_Circle.Visible = isVisible
    for _, ring in ipairs(glowRings) do
        ring.Visible = isVisible
    end
end

-- Toggle with 'E'
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        updateVisibility(enabled)
        if not enabled then
            lockedTarget = nil
        end
    end
end)

local function getTarget()
    local mouse = UserInputService:GetMouseLocation()
    
    -- Robust sticky lock: maintains lock on the chosen target until they die or leave screen
    if lockedTarget and lockedTarget.Parent and lockedTarget.Parent:FindFirstChild("Humanoid") then
        local humanoid = lockedTarget.Parent.Humanoid
        if humanoid.Health > 0 then
            local _, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen then
                return lockedTarget
            end
        end
    end
    
    lockedTarget = nil
    local closest, minD = nil, FOV_RADIUS
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local humanoid = p.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if dist <= minD then
                        minD = dist
                        closest = head
                    end
                end
            end
        end
    end
    
    lockedTarget = closest
    return lockedTarget
end

RunService.RenderStepped:Connect(function()
    local mouse = UserInputService:GetMouseLocation()
    
    -- Sync FOV circle position instantly to follow your cursor
    FOV_Circle.Position = mouse
    for _, ring in ipairs(glowRings) do
        ring.Position = mouse
    end
    
    if not enabled then return end
    
    local target = getTarget()
    if target then
        -- ANGLE-BASED MOUSE LOCK MATHEMATICAL CONVERSION
        -- Computes exact 3D Yaw and Pitch angles from camera to head, eliminating distance/height drift.
        local camCFrame = Camera.CFrame
        local localVector = camCFrame:VectorToObjectSpace(target.Position - camCFrame.Position)
        
        local yaw = math.atan2(-localVector.X, -localVector.Z)
        local pitch = math.asin(localVector.Y / localVector.Magnitude)
        
        -- Convert radians to precise screen mouse pixels based on current resolution and FOV
        local viewportSize = Camera.ViewportSize
        local fovRad = math.rad(Camera.FieldOfView)
        
        local scaleX = (viewportSize.X / fovRad) * MOUSE_SENSITIVITY
        local scaleY = (viewportSize.Y / fovRad) * MOUSE_SENSITIVITY
        
        local deltaX = yaw * scaleX
        local deltaY = -pitch * scaleY
        
        -- Direct mouse cursor actuation (Mouse Lock, NOT Camera Lock) with zero prediction
        mousemoverrel(deltaX, deltaY)
    end
end)
