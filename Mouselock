local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 40

-- === CRITICAL SETTINGS FOR FPS/TACTICAL GAMES ===
-- If the aimbot violently shakes or overshoots, INCREASE this number (e.g., 5, 8, 10).
-- If it tracks the head too slowly, DECREASE this number (e.g., 1.5, 2).
local SENSITIVITY_DIVISOR = 10 

-- 3D Offset: Adjusts the aiming point in the actual game world rather than on your 2D screen.
-- This completely prevents the aim from drifting higher/lower when distance changes.
-- Use small decimals (e.g., 0.5 aims slightly above the center of the head, -0.5 aims below).
local Y_3D_OFFSET = 0.2 
-- ================================================

local enabled = false
local lockedTarget = nil

-- Intense gradient glow setup
local glowRings = {}
local layerCount = 12
for i = 1, layerCount do
    local ring = Drawing.new("Circle")
    ring.Visible = false
    ring.Radius = FOV_RADIUS + (i * 1.5)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.55 - (i * 0.04), 0.03, 0.55)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

-- Main FOV Circle
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = false
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function updateVisibility(isVisible)
    FOV_Circle.Visible = isVisible
    for _, ring in ipairs(glowRings) do
        ring.Visible = isVisible
    end
end

-- Toggle with 'E'
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        updateVisibility(enabled)
        if not enabled then
            lockedTarget = nil
        end
    end
end)

local function getTarget()
    local mouse = UserInputService:GetMouseLocation()
    
    -- 100% Hard-Lock logic
    if lockedTarget and lockedTarget.Parent and lockedTarget.Parent:FindFirstChild("Humanoid") then
        local humanoid = lockedTarget.Parent.Humanoid
        if humanoid.Health > 0 then
            -- Verify target is still on screen
            local _, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen then
                return lockedTarget
            end
        end
    end
    
    lockedTarget = nil
    local closest, minD = nil, FOV_RADIUS
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local humanoid = p.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                -- Apply the 3D height offset HERE before calculating the 2D position
                local targetPosition3D = head.Position + Vector3.new(0, Y_3D_OFFSET, 0)
                local pos, onScreen = Camera:WorldToViewportPoint(targetPosition3D)
                
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if dist <= minD then
                        minD = dist
                        closest = head
                    end
                end
            end
        end
    end
    
    lockedTarget = closest
    return lockedTarget
end

RunService.RenderStepped:Connect(function()
    local mouse = UserInputService:GetMouseLocation()
    
    -- Update UI FOV Ring
    FOV_Circle.Position = mouse
    for _, ring in ipairs(glowRings) do
        ring.Position = mouse
    end
    
    if not enabled then return end
    
    local target = getTarget()
    if target then
        -- Calculate the exact 3D position again with our fix applied
        local targetPosition3D = target.Position + Vector3.new(0, Y_3D_OFFSET, 0)
        local pos, onScreen = Camera:WorldToViewportPoint(targetPosition3D)
        
        if onScreen then
            -- Calculate raw pixel distance
            local deltaX = pos.X - mouse.X
            local deltaY = pos.Y - mouse.Y
            
            -- Divide the movement by the sensitivity divisor. 
            -- This acts as a conversion ratio from "Pixels" to "3D Camera Rotation",
            -- entirely preventing the violently shaky overshoot bug.
            mousemoverel(deltaX / SENSITIVITY_DIVISOR, deltaY / SENSITIVITY_DIVISOR)
        end
    end
end)
