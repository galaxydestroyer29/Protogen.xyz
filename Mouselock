local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 40
local enabled = false
local lockedTarget = nil

-- Create intense gradient glow effect using 12 layered circles
local glowRings = {}
local layerCount = 12
for i = 1, layerCount do
    local ring = Drawing.new("Circle")
    ring.Visible = false
    ring.Radius = FOV_RADIUS + (i * 1.5)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.55 - (i * 0.04), 0.03, 0.55)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

-- Main FOV Circle
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = false
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function updateVisibility(isVisible)
    FOV_Circle.Visible = isVisible
    for _, ring in ipairs(glowRings) do
        ring.Visible = isVisible
    end
    if not isVisible then
        Camera.CameraType = Enum.CameraType.Custom
    end
end

-- Toggle with 'E'
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        updateVisibility(enabled)
        if not enabled then
            lockedTarget = nil
            Camera.CameraType = Enum.CameraType.Custom
        end
    end
end)

local function getTarget()
    local mouse = UserInputService:GetMouseLocation()
    
    -- Sticky lock check: maintain lock on chosen target
    if lockedTarget and lockedTarget.Parent and lockedTarget.Parent:FindFirstChild("Humanoid") then
        local humanoid = lockedTarget.Parent.Humanoid
        if humanoid.Health > 0 then
            local _, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen then
                return lockedTarget
            end
        end
    end
    
    lockedTarget = nil
    local closest, minD = nil, FOV_RADIUS
    
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local head = p.Character:FindFirstChild("Head")
            local humanoid = p.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if dist < minD then
                        minD = dist
                        closest = head
                    end
                end
            end
        end
    end
    
    lockedTarget = closest
    return lockedTarget
end

RunService.RenderStepped:Connect(function()
    local mouse = UserInputService:GetMouseLocation()
    
    -- Update positions for main circle and glow layers
    FOV_Circle.Position = mouse
    for _, ring in ipairs(glowRings) do
        ring.Position = mouse
    end
    
    if not enabled then return end
    
    local target = getTarget()
    if target then
        -- Prevent Roblox core camera scripts from fighting updates during jumps and movement
        if Camera.CameraType ~= Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Scriptable
        end
        
        -- Lock camera position to the local player's head while looking directly at the target's head
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
            local localHead = LocalPlayer.Character.Head.Position
            Camera.CFrame = CFrame.new(localHead, target.Position)
        else
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
        end
    else
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
    end
end)
