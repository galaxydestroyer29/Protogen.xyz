
print("[AimSystem] Execution started.")

local success, initError = pcall(function()
    local Players = game:GetService("Players")
    local RunService = game:GetService("RunService")
    local UserInputService = game:GetService("UserInputService")
    local Workspace = game:GetService("Workspace")
    local Camera = Workspace.CurrentCamera

    local LocalPlayer = Players.LocalPlayer
    if not LocalPlayer then
        local playerAddedConnection
        playerAddedConnection = Players.PlayerAdded:Connect(function(p)
            if p == Players.LocalPlayer then
                LocalPlayer = p
                playerAddedConnection:Disconnect()
            end
        end)
        repeat task.wait() until Players.LocalPlayer
        LocalPlayer = Players.LocalPlayer
    end

    if not Camera then
        Workspace:GetPropertyChangedSignal("CurrentCamera"):Wait()
        Camera = Workspace.CurrentCamera
    end

    -- Configuration Table (Featuring Precise Ballistic Calculator)
    local Settings = {
        Enabled = false,           -- Hard Lock Aimbot Toggle
        SilentEnabled = false,     -- Silent Aim Toggle
        HbeEnabled = false,        -- Hitbox Expander Toggle
        VisibilityCheck = false,   -- WallCheck Toggle
        AimPart = "Head",          
        FOVRadius = 70,            
        ShowFOV = true,            
        BulletSpeed = 2500,        -- Studs per second (Adjustable for projectile velocity)
        GravityMultiplier = 1.0,   -- Fine-tunes parabolic drop compensation
        VerticalDampening = 0.25,  -- Dampens erratic vertical velocity jitter
    }

    -- Hitbox Expander Configuration
    local EXPANDED_SIZE = Vector3.new(10, 10, 10)
    local ORIGINAL_SIZES = {}

    -- Persistent Target Cache for Stickiness & Performance
    local cachedTarget = nil
    local ActiveTargets = {}

    -- Optimized Background Target Refresher (Scans Workspace descendants & folders for NPCs/Players)
    task.spawn(function()
        while true do
            pcall(function()
                table.clear(ActiveTargets)
                
                for _, obj in ipairs(Workspace:GetDescendants()) do
                    if obj:IsA("Model") and obj ~= LocalPlayer.Character then
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        local aimPart = obj:FindFirstChild(Settings.AimPart)
                        if humanoid and humanoid.Health > 0 and aimPart then
                            if not obj:IsDescendantOf(LocalPlayer.Character) then
                                table.insert(ActiveTargets, obj)
                            end
                        end
                    end
                end
            end)
            task.wait(0.5)
        end
    end)

    -- GUI Construction
    local playerGui = LocalPlayer:WaitForChild("PlayerGui", 10)
    if not playerGui then
        error("PlayerGui could not be found!")
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "ClientAimSystemGui"
    ScreenGui.ResetOnSpawn = false
    ScreenGui.IgnoreGuiInset = true
    ScreenGui.Parent = playerGui

    -- Top Left Control Container (Sized for 4 buttons)
    local ControlContainer = Instance.new("Frame")
    ControlContainer.Name = "ControlContainer"
    ControlContainer.Position = UDim2.new(0, 15, 0, 15)
    ControlContainer.Size = UDim2.new(0, 160, 0, 154)
    ControlContainer.BackgroundTransparency = 1
    ControlContainer.Parent = ScreenGui

    local UIListLayout = Instance.new("UIListLayout")
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    UIListLayout.Padding = UDim.new(0, 6)
    UIListLayout.Parent = ControlContainer

    local function CreateButton(name, text, layoutOrder)
