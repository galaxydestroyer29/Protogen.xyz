    local ActivationButton = CreateButton("ActivationButton", "Aim: OFF", 1)
    local SilentButton = CreateButton("SilentButton", "Silent: OFF", 2)
    local HbeButton = CreateButton("HbeButton", "HBE: OFF", 3)
    local VisibilityButton = CreateButton("VisibilityButton", "WallCheck: OFF", 4)

    -- FOV Circle Frame
    local FOVFrame = Instance.new("Frame")
    FOVFrame.Name = "FOVCircle"
    FOVFrame.AnchorPoint = Vector2.new(0.5, 0.5)
    FOVFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
    FOVFrame.Size = UDim2.new(0, Settings.FOVRadius * 2, 0, Settings.FOVRadius * 2)
    FOVFrame.BackgroundTransparency = 0.92
    FOVFrame.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    FOVFrame.BorderSizePixel = 0
    FOVFrame.Parent = ScreenGui

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(1, 0)
    UICorner.Parent = FOVFrame

    local UIStroke = Instance.new("UIStroke")
    UIStroke.Name = "WhiteGlowStroke"
    UIStroke.Color = Color3.fromRGB(255, 255, 255)
    UIStroke.Thickness = 2.5
    UIStroke.Transparency = 0.25
    UIStroke.Parent = FOVFrame

    -- Silent Aim Tracer Line
    local TracerLine = Instance.new("Frame")
    TracerLine.Name = "TracerLine"
    TracerLine.AnchorPoint = Vector2.new(0, 0.5)
    TracerLine.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    TracerLine.BackgroundTransparency = 0.3
    TracerLine.BorderSizePixel = 0
    TracerLine.Size = UDim2.new(0, 0, 0, 0.7)
    TracerLine.Visible = false
    TracerLine.Parent = ScreenGui

    -- Red Target Indicator Circle (Floats above active target)
    local TargetIndicatorCircle = Instance.new("Frame")
    TargetIndicatorCircle.Name = "TargetIndicatorCircle"
    TargetIndicatorCircle.AnchorPoint = Vector2.new(0.5, 0.5)
    TargetIndicatorCircle.Size = UDim2.new(0, 16, 0, 16)
    TargetIndicatorCircle.BackgroundColor3 = Color3.fromRGB(255, 45, 45)
    TargetIndicatorCircle.BackgroundTransparency = 0.2
    TargetIndicatorCircle.Visible = false
    TargetIndicatorCircle.Parent = ScreenGui

    local CircleCorner = Instance.new("UICorner")
    CircleCorner.CornerRadius = UDim.new(1, 0)
