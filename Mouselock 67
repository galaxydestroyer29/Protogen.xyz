--[[\
    Advanced Zero-Prediction Mouse-Lock Aim Automation System
    Target Environment: Locked-Center Tactical / FPS Frameworks
    Features: 40px FOV, 12-Layer Gradient Glow, Sticky Head Lock, 'E' Toggle
]]--

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Configuration Parameters
local FOV_RADIUS = 40
local ENABLED = false
local LOCKED_TARGET = nil

-- Sensitivity scaling factor to bridge angular delta with engine mouse processing
-- Adjust this value if tracking feels too fast (increase) or too slow (decrease)
local MOUSE_SENSITIVITY_SCALE = 1.2

-- Initialize 12-Layer Gradient Glow FOV Rings
local glowRings = {}
local layerCount = 12
for i = 1, layerCount do
    local ring = Drawing.new("Circle")
    ring.Visible = false
    ring.Radius = FOV_RADIUS + (i * 1.5)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.55 - (i * 0.04), 0.03, 0.55)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

-- Main FOV Circle Layer
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = false
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function setVisualsVisible(state)
    FOV_Circle.Visible = state
    for _, ring in ipairs(glowRings) do
        ring.Visible = state
    end
end

-- Input Toggle Listener ('E' Key)
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
        ENABLED = not ENABLED
        setVisualsVisible(ENABLED)
        if not ENABLED then
            LOCKED_TARGET = nil
        end
    end
end)

local function getClosestTargetWithinFOV()
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    -- Maintain Sticky Lock: Verify current locked target remains valid, alive, and on-screen
    if LOCKED_TARGET and LOCKED_TARGET.Parent and LOCKED_TARGET.Parent:FindFirstChild("Humanoid") then
        local humanoid = LOCKED_TARGET.Parent.Humanoid
        if humanoid.Health > 0 then
            local _, onScreen = Camera:WorldToViewportPoint(LOCKED_TARGET.Position)
            if onScreen then
                return LOCKED_TARGET
            end
        end
    end
    
    -- Reset lock and scan for the closest valid target within the FOV radius
    LOCKED_TARGET = nil
    local closestTarget = nil
    local minDistance = FOV_RADIUS
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local viewportPos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local screenPos2D = Vector2.new(viewportPos.X, viewportPos.Y)
                    local distanceToCenter = (screenPos2D - screenCenter).Magnitude
                    
                    if distanceToCenter <= minDistance then
                        minDistance = distanceToCenter
                        closestTarget = head
                    end
                end
            end
        end
    end
    
    LOCKED_TARGET = closestTarget
    return LOCKED_TARGET
end

RunService.RenderStepped:Connect(function()
    -- Center position for crosshair/FOV rendering in locked-center environments
    local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    
    -- Synchronize FOV Circle and Glow Rings to Screen Center
    FOV_Circle.Position = screenCenter
    for _, ring in ipairs(glowRings) do
        ring.Position = screenCenter
    end
    
    if not ENABLED then return end
    
    local targetHead = getClosestTargetWithinFOV()
    if targetHead then
        -- Angular Delta Calculation (Yaw & Pitch) for precise mouse-aim simulation
        local camCFrame = Camera.CFrame
        local objectSpaceVector = camCFrame:VectorToObjectSpace(targetHead.Position - camCFrame.Position)
        
        local yaw = math.atan2(-objectSpaceVector.X, -objectSpaceVector.Z)
        local pitch = math.asin(objectSpaceVector.Y / objectSpaceVector.Magnitude)
        
        -- Convert angular radians into screen-space pixel deltas based on active viewport dimensions and FOV
        local viewportSize = Camera.ViewportSize
        local fovRadians = math.rad(Camera.FieldOfView)
        
        local scaleFactorX = (viewportSize.X / fovRadians) * MOUSE_SENSITIVITY_SCALE
        local scaleFactorY = (viewportSize.Y / fovRadians) * MOUSE_SENSITIVITY_SCALE
        
        local deltaX = yaw * scaleFactorX
        local deltaY = -pitch * scaleFactorY
        
        -- Transmit raw relative mouse adjustment packets
        mousemoverrel(deltaX, deltaY)
    end
end)
