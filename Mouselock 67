local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local FOV_RADIUS = 40
local enabled = false
local lockedTarget = nil

-- TUNING: Controls the snap speed/smoothness to prevent the mouse from flying off when moving or jumping.
-- Higher number = smoother/slower pull; Lower number = faster snap. (Recommended: 2.0 to 3.0)
local SMOOTHING = 2.5 

-- Create 12-Layer Gradient Glow FOV Rings
local glowRings = {}
local layerCount = 12
for i = 1, layerCount do
    local ring = Drawing.new("Circle")
    ring.Visible = false
    ring.Radius = FOV_RADIUS + (i * 1.5)
    ring.Color = Color3.fromRGB(255, 255, 255)
    ring.Transparency = math.clamp(0.55 - (i * 0.04), 0.03, 0.55)
    ring.Thickness = 1
    ring.Filled = false
    table.insert(glowRings, ring)
end

-- Main FOV Circle Layer
local FOV_Circle = Drawing.new("Circle")
FOV_Circle.Visible = false
FOV_Circle.Radius = FOV_RADIUS
FOV_Circle.Color = Color3.fromRGB(255, 255, 255)
FOV_Circle.Thickness = 1.5
FOV_Circle.Transparency = 1
FOV_Circle.Filled = false

local function updateVisibility(isVisible)
    FOV_Circle.Visible = isVisible
    for _, ring in ipairs(glowRings) do
        ring.Visible = isVisible
    end
end

-- Toggle with 'E'
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if not gameProcessed and input.KeyCode == Enum.KeyCode.E then
        enabled = not enabled
        updateVisibility(enabled)
        if not enabled then
            lockedTarget = nil
        end
    end
end)

local function getTarget()
    local mouse = UserInputService:GetMouseLocation()
    
    -- Sticky lock: Once locked on a player, keep tracking them until they die or leave the screen
    if lockedTarget and lockedTarget.Parent and lockedTarget.Parent:FindFirstChild("Humanoid") then
        local humanoid = lockedTarget.Parent.Humanoid
        if humanoid.Health > 0 then
            local _, onScreen = Camera:WorldToViewportPoint(lockedTarget.Position)
            if onScreen then
                return lockedTarget
            end
        end
    end
    
    -- Find closest player whose head is inside the FOV circle around your cursor
    lockedTarget = nil
    local closest, minD = nil, FOV_RADIUS
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local head = player.Character:FindFirstChild("Head")
            local humanoid = player.Character:FindFirstChild("Humanoid")
            
            if head and humanoid and humanoid.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(head.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
                    if dist <= minD then
                        minD = dist
                        closest = head
                    end
                end
            end
        end
    end
    
    lockedTarget = closest
    return lockedTarget
end

RunService.RenderStepped:Connect(function()
    local mouse = UserInputService:GetMouseLocation()
    
    -- Make the FOV circle and its glow rings instantly follow your in-game mouse cursor
    FOV_Circle.Position = mouse
    for _, ring in ipairs(glowRings) do
        ring.Position = mouse
    end
    
    if not enabled then return end
    
    local target = getTarget()
    if target then
        local pos, onScreen = Camera:WorldToViewportPoint(target.Position)
        if onScreen then
            -- Calculate pixel distance from current mouse position to target's head
            local deltaX = pos.X - mouse.X
            local deltaY = pos.Y - mouse.Y
            
            -- Lock mouse cursor to the target smoothly, preventing flying/jumping bugs
            mousemoverrel(deltaX / SMOOTHING, deltaY / SMOOTHING)
        end
    end
end)
