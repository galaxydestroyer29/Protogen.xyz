-- Universal Skeleton & Dynamic Health ESP (Players + NPCs) - Native UI Engine
-- Environment: Roblox Client (LocalScript)

local CoreGui = game:GetService("CoreGui");
local Players = game:GetService("Players");
local RunService = game:GetService("RunService");
local Workspace = game:GetService("Workspace");

local LocalPlayer = Players.LocalPlayer;
local Camera = Workspace.CurrentCamera;

-- Prevent duplicate execution stacking
if getgenv()._UniversalESPUI then
    pcall(function()
        getgenv()._UniversalESPUI:Destroy();
    end);
    getgenv()._UniversalESPUI = nil;
end

local ScreenGui = Instance.new("ScreenGui");
ScreenGui.Name = "UniversalESP_Native";
ScreenGui.ResetOnSpawn = false;
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling;
ScreenGui.IgnoreGuiInset = true;

pcall(function()
    local env = getgenv();
    local synLib = env.syn;
    if synLib and synLib.protect_gui then
        synLib.protect_gui(ScreenGui);
        ScreenGui.Parent = CoreGui;
    elseif gethui then
        ScreenGui.Parent = gethui();
    else
        ScreenGui.Parent = CoreGui;
    end
end);

getgenv()._UniversalESPUI = ScreenGui;

local CONFIG = {
    TeamCheck = false,
    
    -- Skeleton Settings
    SkeletonEnabled = true,
    SkeletonColor = Color3.fromRGB(0, 240, 255),
    SkeletonThickness = 1.5,
    
    -- UI Elements
    HealthBarEnabled = true,
    NameEnabled = true,
    DistanceEnabled = true,
};

-- Rig connection definitions (R6 & R15)
local R6_CONNECTIONS = {
    {"Head", "Torso"},
    {"Torso", "Left Arm"},
    {"Torso", "Right Arm"},
    {"Torso", "Left Leg"},
    {"Torso", "Right Leg"}
};

local R15_CONNECTIONS = {
    {"Head", "UpperTorso"},
    {"UpperTorso", "LowerTorso"},
    {"UpperTorso", "LeftUpperArm"},
    {"LeftUpperArm", "LeftLowerArm"},
    {"LeftLowerArm", "LeftHand"},
    {"UpperTorso", "RightUpperArm"},
    {"RightUpperArm", "RightLowerArm"},
    {"RightLowerArm", "RightHand"},
    {"LowerTorso", "LeftUpperLeg"},
    {"LeftUpperLeg", "LeftLowerLeg"},
    {"LeftLowerLeg", "LeftFoot"},
    {"LowerTorso", "RightUpperLeg"},
    {"RightUpperLeg", "RightLowerLeg"},
    {"RightLowerLeg", "RightFoot"}
};

local espCache = {};

-- Helper to interpolate health bar color (Green -> Yellow -> Red)
local function getHealthColor(percent)
    percent = math.clamp(percent, 0, 1);
    if percent > 0.5 then
        return Color3.fromRGB(255, 255, 0):Lerp(Color3.fromRGB(0, 255, 100), (percent - 0.5) * 2);
    else
        return Color3.fromRGB(255, 40, 40):Lerp(Color3.fromRGB(255, 255, 0), percent * 2);
    end
end

-- Helper to position and orient a UI Frame as a 2D vector line
local function drawLine(frame, p1, p2, thickness, color)
    local dx = p2.X - p1.X;
    local dy = p2.Y - p1.Y;
    local dist = math.sqrt(dx * dx + dy * dy);
    local angle = math.deg(math.atan2(dy, dx));

    frame.Position = UDim2.new(0, (p1.X + p2.X) / 2 - dist / 2, 0, (p1.Y + p2.Y) / 2 - thickness / 2);
    frame.Size = UDim2.new(0, dist, 0, thickness);
    frame.Rotation = angle;
    frame.BackgroundColor3 = color;
    frame.Visible = true;
end

local function createEntityUI()
    local container = Instance.new("Folder");
    container.Name = "EntityESP";
    container.Parent = ScreenGui;

    -- Skeleton Line Pool (up to 16 lines max for R15)
    local skeletonLines = {};
    for i = 1, 16 do
        local line = Instance.new("Frame");
        line.Name = "SkeletonLine_" .. i;
        line.AnchorPoint = Vector2.new(0.5, 0.5);
        line.BorderSizePixel = 0;
        line.Visible = false;
        line.Parent = container;
        table.insert(skeletonLines, line);
    end

    local healthBorder = Instance.new("Frame");
    healthBorder.Name = "HealthBorder";
    healthBorder.BackgroundColor3 = Color3.fromRGB(0, 0, 0);
    healthBorder.BorderSizePixel = 0;
    healthBorder.Visible = false;
    healthBorder.Parent = container;

    local healthBg = Instance.new("Frame");
    healthBg.Name = "HealthBg";
    healthBg.BackgroundColor3 = Color3.fromRGB(20, 20, 25);
    healthBg.BackgroundTransparency = 0.15;
    healthBg.BorderSizePixel = 0;
    healthBg.Visible = false;
    healthBg.Parent = container;

    local healthFill = Instance.new("Frame");
    healthFill.Name = "HealthFill";
    healthFill.BackgroundColor3 = Color3.fromRGB(255, 255, 255);
    healthFill.BorderSizePixel = 0;
    healthFill.Visible = false;
    healthFill.Parent = container;

    local nameText = Instance.new("TextLabel");
    nameText.Name = "NameText";
    nameText.BackgroundTransparency = 1;
    nameText.TextColor3 = Color3.fromRGB(255, 255, 255);
    nameText.TextStrokeTransparency = 0;
    nameText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0);
    nameText.TextSize = 12;
    nameText.Font = Enum.Font.SourceSansBold;
    nameText.TextXAlignment = Enum.TextXAlignment.Center;
    nameText.Visible = false;
    nameText.Parent = container;

    local distanceText = Instance.new("TextLabel");
    distanceText.Name = "DistanceText";
    distanceText.BackgroundTransparency = 1;
    distanceText.TextColor3 = Color3.fromRGB(160, 180, 200);
    distanceText.TextStrokeTransparency = 0;
    distanceText.TextStrokeColor3 = Color3.fromRGB(0, 0, 0);
    distanceText.TextSize = 11;
    distanceText.Font = Enum.Font.SourceSansBold;
    distanceText.TextXAlignment = Enum.TextXAlignment.Center;
    distanceText.Visible = false;
    distanceText.Parent = container;

    return {
        Container = container,
        SkeletonLines = skeletonLines,
        HealthBorder = healthBorder,
        HealthBg = healthBg,
        HealthFill = healthFill,
        NameText = nameText,
        DistanceText = distanceText,
    };
end

local function removeEntityCache(key)
    if espCache[key] then
        if espCache[key].Container then
            pcall(function()
                espCache[key].Container:Destroy();
            end);
        end
        espCache[key] = nil;
    end
end

local function setupPlayer(player)
    if player == LocalPlayer then return; end
    espCache[player] = createEntityUI();
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player);
end

Players.PlayerAdded:Connect(setupPlayer);
Players.PlayerRemoving:Connect(function(player)
    removeEntityCache(player);
end);

local function checkAndSetupNPC(model)
    if not model:IsA("Model") then return; end
    if model == LocalPlayer.Character then return; end
    if Players:GetPlayerFromCharacter(model) then return; end
    if espCache[model] then return; end

    local humanoid = model:FindFirstChildOfClass("Humanoid");
    local rootPart = model:FindFirstChild("HumanoidRootPart");

    if humanoid and rootPart then
        espCache[model] = createEntityUI();
    end
end

for _, obj in ipairs(Workspace:GetDescendants()) do
    local model = obj:FindFirstAncestorOfClass("Model");
    if model then
        checkAndSetupNPC(model);
    end
end

Workspace.DescendantAdded:Connect(function(child)
    if child:IsA("Humanoid") or child.Name == "HumanoidRootPart" or child:IsA("Model") then
        local model = child:IsA("Model") and child or child:FindFirstAncestorOfClass("Model");
        if model then
            checkAndSetupNPC(model);
        end
    end
end);

RunService.RenderStepped:Connect(function()
    local camPos = Camera.CFrame.Position;

    for key, cache in pairs(espCache) do
        local character = nil;
        local entityName = "";
        
        if typeof(key) == "Instance" and key:IsA("Player") then
            if key ~= LocalPlayer then
                character = key.Character;
                entityName = key.Name;
            end
        elseif typeof(key) == "Instance" and key:IsA("Model") then
            character = key;
            entityName = key.Name;
        end

        local shouldHide = true;

        if character and character:FindFirstChild("HumanoidRootPart") and character.Parent then
            local humanoid = character:FindFirstChildOfClass("Humanoid");
            local rootPart = character:FindFirstChild("HumanoidRootPart");
            
            if humanoid and humanoid.Health > 0 and rootPart then
                local passTeamCheck = true;
                if typeof(key) == "Instance" and key:IsA("Player") then
                    if CONFIG.TeamCheck and key.Team == LocalPlayer.Team then
                        passTeamCheck = false;
                    end
                end

                if passTeamCheck then
                    -- Bounds calculation for UI element positioning
                    local minX, minY = math.huge, math.huge;
                    local maxX, maxY = -math.huge, -math.huge;
                    local validPoints = false;

                    for _, part in ipairs(character:GetChildren()) do
                        if part:IsA("BasePart") then
                            local n = part.Name;
                            if n == "Head" or n:find("Torso") or n:find("Leg") or n:find("Arm") or n:find("Foot") or n == "HumanoidRootPart" then
                                local cf = part.CFrame;
                                local size = part.Size * 0.5;

                                local corners = {
                                    cf * Vector3.new(-size.X,  size.Y, -size.Z),
                                    cf * Vector3.new( size.X,  size.Y, -size.Z),
                                    cf * Vector3.new(-size.X, -size.Y, -size.Z),
                                    cf * Vector3.new( size.X, -size.Y, -size.Z),
                                    cf * Vector3.new(-size.X,  size.Y,  size.Z),
                                    cf * Vector3.new( size.X,  size.Y,  size.Z),
                                    cf * Vector3.new(-size.X, -size.Y,  size.Z),
                                    cf * Vector3.new( size.X, -size.Y,  size.Z),
                                };

                                for i = 1, 8 do
                                    local screenPos = Camera:WorldToViewportPoint(corners[i]);
                                    if screenPos.Z > 0 then
                                        validPoints = true;
                                        minX = math.min(minX, screenPos.X);
                                        maxX = math.max(maxX, screenPos.X);
                                        minY = math.min(minY, screenPos.Y);
                                        maxY = math.max(maxY, screenPos.Y);
                                    end
                                end
                            end
                        end
                    end

                    if validPoints then
                        shouldHide = false;

                        local width = maxX - minX;
                        local height = maxY - minY;
                        local x = minX;
                        local y = minY;

                        -- Render Skeleton Lines
                        if CONFIG.SkeletonEnabled then
                            local isR15 = humanoid.RigType == Enum.HumanoidRigType.R15;
                            local connections = isR15 and R15_CONNECTIONS or R6_CONNECTIONS;
                            local lineIndex = 1;

                            for _, connection in ipairs(connections) do
                                local partA = character:FindFirstChild(connection[1]);
                                local partB = character:FindFirstChild(connection[2]);

                                if partA and partB then
                                    local posA, visA = Camera:WorldToViewportPoint(partA.Position);
                                    local posB, visB = Camera:WorldToViewportPoint(partB.Position);

                                    if posA.Z > 0 and posB.Z > 0 then
                                        local lineFrame = cache.SkeletonLines[lineIndex];
                                        if lineFrame then
                                            drawLine(lineFrame, posA, posB, CONFIG.SkeletonThickness, CONFIG.SkeletonColor);
                                            lineIndex = lineIndex + 1;
                                        end
                                    end
                                end
                            end

                            -- Hide remaining unused skeleton lines
                            for i = lineIndex, #cache.SkeletonLines do
                                cache.SkeletonLines[i].Visible = false;
                            end
                        else
                            for _, lineFrame in ipairs(cache.SkeletonLines) do
                                lineFrame.Visible = false;
                            end
                        end

                        -- Dynamic Gradient Health Bar
                        if CONFIG.HealthBarEnabled then
                            local barWidth = 3;
                            local barOffset = 5;
                            local healthPercent = math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1);
                            local barHeight = height * healthPercent;
                            local dynamicHealthColor = getHealthColor(healthPercent);

                            cache.HealthBorder.Position = UDim2.new(0, x - barWidth - barOffset - 1, 0, y - 1);
                            cache.HealthBorder.Size = UDim2.new(0, barWidth + 2, 0, height + 2);
                            cache.HealthBorder.Visible = true;

                            cache.HealthBg.Position = UDim2.new(0, x - barWidth - barOffset, 0, y);
                            cache.HealthBg.Size = UDim2.new(0, barWidth, 0, height);
                            cache.HealthBg.Visible = true;

                            cache.HealthFill.Position = UDim2.new(0, x - barWidth - barOffset, 0, y + (height - barHeight));
                            cache.HealthFill.Size = UDim2.new(0, barWidth, 0, barHeight);
                            cache.HealthFill.BackgroundColor3 = dynamicHealthColor;
                            cache.HealthFill.Visible = true;
                        else
                            cache.HealthBorder.Visible = false;
                            cache.HealthBg.Visible = false;
                            cache.HealthFill.Visible = false;
                        end

                        -- Distance Text
                        if CONFIG.DistanceEnabled then
                            local distance = (camPos - rootPart.Position).Magnitude;
                            cache.DistanceText.Text = math.floor(distance) .. "m";
                            cache.DistanceText.Position = UDim2.new(0, x + (width / 2) - 50, 0, y + height + 3);
                            cache.DistanceText.Size = UDim2.new(0, 100, 0, 15);
                            cache.DistanceText.Visible = true;
                        else
                            cache.DistanceText.Visible = false;
                        end

                        -- Name Text
                        if CONFIG.NameEnabled and entityName ~= "" then
                            cache.NameText.Text = entityName;
                            cache.NameText.Position = UDim2.new(0, x + (width / 2) - 75, 0, y - 18);
                            cache.NameText.Size = UDim2.new(0, 150, 0, 16);
                            cache.NameText.Visible = true;
                        else
                            cache.NameText.Visible = false;
                        end
                    end
                end
            end
        end

        if shouldHide then
            for _, lineFrame in ipairs(cache.SkeletonLines) do
                lineFrame.Visible = false;
            end
            cache.HealthBorder.Visible = false;
            cache.HealthBg.Visible = false;
            cache.HealthFill.Visible = false;
            cache.NameText.Visible = false;
            cache.DistanceText.Visible = false;

            if typeof(key) == "Instance" and key:IsA("Model") and (not character or not character.Parent) then
                removeEntityCache(key);
            end
        end
    end
end);
